---
// src/pages/index.astro

const tariffs = [
  {
    name: "Free",
    price: "0",
    period: "₽/мес",
    tagline: "Первые платежи и тесты",
    features: ["Публичные ставки провайдеров", "Базовый дашборд", "Email-поддержка"],
  },
  {
    name: "Pro",
    price: "20 000",
    period: "₽/мес",
    tagline: "Растущий объём платежей",
    features: [
      "Сниженные ставки провайдеров",
      "Расширенная аналитика",
      "Рекуррентные платежи и возвраты",
      "Приоритетная поддержка",
    ],
    highlight: true,
  },
  {
    name: "Enterprise",
    price: "50 000",
    period: "₽/мес",
    tagline: "Высокие объёмы, свои SLA",
    features: [
      "Лучшие ставки на объёме",
      "Роутинг и резервные провайдеры",
      "Персональный менеджер",
      "SLA и кастомные интеграции",
    ],
  },
];

const dataset = [
  { value: "5,000", label: "бизнес-аккаунтов" },
  { value: "8", label: "платёжных систем" },
  { value: "200,000", label: "платёжных попыток" },
  { value: "15,000", label: "подписок" },
  { value: "22–26", label: "период данных, гг." },
];

const stack = ["PostgreSQL", "Python", "pandas", "NumPy", "Window Functions", "Git"];

const tickerBase = [
  { provider: "Эквайринг-банк", amount: "₽482,300", status: "ok" },
  { provider: "Платёжный шлюз", amount: "₽129,900", status: "ok" },
  { provider: "Кошелёк", amount: "₽76,450", status: "pending" },
  { provider: "Перевод", amount: "₽1,204,000", status: "ok" },
  { provider: "Платёжный шлюз", amount: "₽58,200", status: "ok" },
  { provider: "Эквайринг-банк", amount: "₽340,100", status: "ok" },
];
const ticker = [...tickerBase, ...tickerBase];

const providers = [
  { label: "Эквайринг банк", y: 70 },
  { label: "Платёжный шлюз", y: 150 },
  { label: "Кошелёк", y: 230 },
  { label: "Переводы", y: 310 },
];
---

<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NexaRoute — Payment Orchestration Analytics</title>
    <meta
      name="description"
      content="NexaRoute — учебный аналитический проект: экономика платёжной оркестрации, маршрутизация провайдеров и юнит-экономика транзакций."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- NAV -->
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="#top">
          <svg class="mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="url(#gradMark)" />
            <path d="M9 11 L23 20 L9 29" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <path d="M9 20 L23 20" stroke="white" stroke-width="2.2" stroke-linecap="round" opacity="0.55" />
            <circle cx="23" cy="20" r="2.6" fill="#E8A33D" />
            <path d="M23 20 L32 20" stroke="white" stroke-width="2.2" stroke-linecap="round" />
            <circle cx="32.5" cy="20" r="1.8" fill="white" />
            <defs>
              <linearGradient id="gradMark" x1="0" y1="0" x2="40" y2="40">
                <stop offset="0" stop-color="#2A4CD6" />
                <stop offset="1" stop-color="#14297A" />
              </linearGradient>
            </defs>
          </svg>
          <span class="wordmark">Nexa<span class="wordmark-accent">Route</span></span>
        </a>
        <nav class="nav-links">
          <a href="#how-it-works">Как это работает</a>
          <a href="#economics">Экономика</a>
          <a href="#pricing">Тарифы</a>
          <a href="#dataset">Данные</a>
        </nav>
        <div class="nav-right">
          <span class="status-pill"><span class="status-dot"></span>Всё работает</span>
          <a
            class="nav-cta"
            href="https://github.com/jaydenwhitehereboyz/saas-revenue-retention-analytics"
            target="_blank"
            rel="noopener">GitHub</a
          >
        </div>
      </div>
    </header>

    <!-- HERO -->
    <section id="top" class="hero">
      <div class="hero-copy">
        <span class="eyebrow">учебный портфолио-проект · синтетические данные</span>
        <h1>Один роутинг.<br />Лучшая цена на каждый платёж.</h1>
        <p class="hero-sub">
          NexaRoute подключает мерчанта к банкам, платёжным шлюзам, кошелькам и
          переводным рельсам через единый API — и направляет каждый платёж
          туда, где он обходится дешевле всего.
        </p>
        <div class="hero-actions">
          <a
            class="btn-primary"
            href="https://github.com/jaydenwhitehereboyz/saas-revenue-retention-analytics"
            target="_blank"
            rel="noopener">Смотреть проект на GitHub</a
          >
          <a class="btn-secondary" href="#how-it-works">Как устроен роутинг ↓</a>
        </div>
        <div class="rail-badges">
          <span class="rail-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 10L12 4L21 10V20H3V10Z" stroke="currentColor" stroke-width="1.6"/><path d="M7 14V20M12 14V20M17 14V20" stroke="currentColor" stroke-width="1.6"/></svg>Банки</span>
          <span class="rail-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="4" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 10H20" stroke="currentColor" stroke-width="1.6"/></svg>Гейтвеи</span>
          <span class="rail-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M16 13H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Кошельки</span>
          <span class="rail-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4 8H16M16 8L12 4M16 8L12 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 16H8M8 16L12 12M8 16L12 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Переводы</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="float-card">
          <span class="float-label">GMV, неделя</span>
          <span class="float-value">+12.4%</span>
          <svg class="spark" viewBox="0 0 100 30" preserveAspectRatio="none">
            <polyline points="0,24 15,20 30,22 45,12 60,15 75,6 100,2" fill="none" stroke="#1C8C74" stroke-width="2.5" />
          </svg>
        </div>
        <div class="phone">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="app-header">
              <span class="app-logo">NR</span>
              <span class="app-bell"><span class="ping"></span></span>
            </div>
            <div class="balance-block">
              <span class="balance-label">Баланс к выплате</span>
              <span class="balance-value">₽4,218,940</span>
            </div>
            <div class="mini-chart">
              <div style="height:30%"></div>
              <div style="height:55%"></div>
              <div style="height:40%"></div>
              <div style="height:70%"></div>
              <div style="height:52%"></div>
              <div style="height:85%" class="active"></div>
              <div style="height:64%"></div>
            </div>
            <div class="tx-list">
              <div class="tx-row">
                <span class="tx-dot ok"></span>
                <span class="tx-name">Эквайринг-банк</span>
                <span class="tx-amount">₽482,300</span>
              </div>
              <div class="tx-row">
                <span class="tx-dot ok"></span>
                <span class="tx-name">Платёжный шлюз</span>
                <span class="tx-amount">₽129,900</span>
              </div>
              <div class="tx-row">
                <span class="tx-dot pending"></span>
                <span class="tx-name">Кошелёк</span>
                <span class="tx-amount">₽76,450</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="ticker-wrap" aria-hidden="true">
      <div class="ticker-track">
        {
          ticker.map((t) => (
            <span class="ticker-item">
              <span class={`dot ${t.status}`} />
              {t.provider}
              <span class="ticker-amount">{t.amount}</span>
            </span>
          ))
        }
      </div>
    </div>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="section">
      <div class="section-head">
        <h2>Как устроена маршрутизация</h2>
        <p class="section-sub">
          NexaRoute собирает объём от тысяч мерчантов и на этом объёме
          договаривается с провайдерами о ставках, недоступных одиночному бизнесу.
        </p>
      </div>

      <svg class="switchboard" viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg">
        <line x1="70" y1="190" x2="262" y2="190" stroke="#1F3FBF" stroke-width="3" stroke-linecap="round" />
        {
          providers.map((p) => (
            <line
              x1="300"
              y1="190"
              x2="536"
              y2={p.y}
              stroke="#C3CBD6"
              stroke-width="2.5"
              stroke-linecap="round"
              class="pulse-line"
            />
          ))
        }

        <circle cx="70" cy="190" r="24" fill="#fff" stroke="#1F3FBF" stroke-width="2" />
        <text x="70" y="195" text-anchor="middle" class="node-label-inner">М</text>
        <text x="70" y="234" text-anchor="middle" class="node-caption">Мерчанты</text>

        <circle cx="300" cy="190" r="40" fill="#1F3FBF" />
        <text x="300" y="196" text-anchor="middle" class="node-label-inner hub">NR</text>

        {
          providers.map((p) => (
            <>
              <circle cx="560" cy={p.y} r="26" fill="#fff" stroke="#1C8C74" stroke-width="2" />
              <text x="560" y={p.y + 5} text-anchor="middle" class="node-label-inner small">₽</text>
              <text x="560" y={p.y + 46} text-anchor="middle" class="node-caption">{p.label}</text>
            </>
          ))
        }
      </svg>

      <ul class="feature-grid">
        <li><strong>Единый API</strong> вместо интеграции с каждым провайдером отдельно</li>
        <li><strong>Роутинг и резерв</strong> — если один провайдер недоступен, платёж уходит другим путём</li>
        <li><strong>Единая отчётность</strong> и сверка по всем каналам сразу</li>
        <li><strong>Рекомендации</strong> по смене тарифа или провайдера на основе данных</li>
      </ul>
    </section>

    <!-- ECONOMICS -->
    <section id="economics" class="section alt">
      <div class="section-head">
        <h2>Экономика одного платежа</h2>
        <p class="section-sub">Клиент оплачивает заказ на 1,000,000 ₽ — вот как расходится сумма.</p>
      </div>

      <div class="receipt">
        <span class="stamp">ОДОБРЕНО · 200 OK</span>
        <div class="receipt-title">NEXAROUTE // CHECK</div>
        <div class="receipt-row">
          <span>Сумма платежа</span><span>1,000,000 ₽</span>
        </div>
        <div class="receipt-row dim">
          <span>Комиссия клиента · 2.9%</span><span>29,000 ₽</span>
        </div>
        <div class="receipt-divider"></div>
        <div class="receipt-row dim">
          <span>Провайдер · 2.5%</span><span>−25,000 ₽</span>
        </div>
        <div class="receipt-row accent">
          <span>Маржа NexaRoute · 0.4%</span><span>4,000 ₽</span>
        </div>
        <div class="receipt-divider"></div>
        <div class="receipt-row total">
          <span>Мерчант получает</span><span>971,000 ₽</span>
        </div>
        <div class="barcode"></div>
      </div>
    </section>

    <!-- ANALYTICS -->
    <section class="section">
      <div class="analytics-layout">
        <div class="analytics-copy">
          <h2>Видно, откуда берётся выручка</h2>
          <p class="section-sub left">
            На тарифах Pro и Enterprise дашборд раскладывает выручку по
            провайдерам, тарифам и когортам мерчантов — вместо одной общей цифры.
          </p>
          <ul class="check-list">
            <li><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 10.5L8 14.5L16 6" stroke="#1C8C74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Динамика GMV и выручки по месяцам</li>
            <li><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 10.5L8 14.5L16 6" stroke="#1C8C74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Маржа по каждому провайдеру и тарифу</li>
            <li><svg width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M4 10.5L8 14.5L16 6" stroke="#1C8C74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Риск-профили и топ мерчантов по доходу</li>
          </ul>
        </div>

        <div class="browser">
          <div class="browser-bar">
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-url">app.nexaroute.io/analytics</span>
          </div>
          <div class="browser-body">
            <div class="kpi-row">
              <div class="kpi-card">
                <span class="kpi-label">GMV, июнь</span>
                <span class="kpi-value">₽18.4M</span>
              </div>
              <div class="kpi-card">
                <span class="kpi-label">Маржа платформы</span>
                <span class="kpi-value teal">0.41%</span>
              </div>
            </div>
            <svg class="bar-chart" viewBox="0 0 320 120" preserveAspectRatio="none">
              <rect x="10" y="60" width="26" height="60" rx="3" fill="#C3CBD6" />
              <rect x="52" y="40" width="26" height="80" rx="3" fill="#C3CBD6" />
              <rect x="94" y="50" width="26" height="70" rx="3" fill="#C3CBD6" />
              <rect x="136" y="24" width="26" height="96" rx="3" fill="#1F3FBF" />
              <rect x="178" y="34" width="26" height="86" rx="3" fill="#C3CBD6" />
              <rect x="220" y="18" width="26" height="102" rx="3" fill="#C3CBD6" />
              <rect x="262" y="8" width="26" height="112" rx="3" fill="#E8A33D" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="section alt">
      <div class="section-head">
        <h2>Тарифы</h2>
        <p class="section-sub">Платная подписка = ниже ставки обработки + больше данных.</p>
      </div>
      <div class="pricing-grid">
        {
          tariffs.map((t) => (
            <div class:list={["price-card", { highlight: t.highlight }]}>
              {t.highlight && <span class="badge">популярный</span>}
              <h3>{t.name}</h3>
              <p class="price-tagline">{t.tagline}</p>
              <div class="price">
                <span class="price-amount">{t.price}</span>
                <span class="price-period">{t.period}</span>
              </div>
              <ul class="price-features">
                {t.features.map((f) => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M4 10.5L8 14.5L16 6" stroke="#1F3FBF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- DATASET -->
    <section id="dataset" class="section">
      <div class="analytics-layout reverse">
        <div class="editor">
          <div class="editor-bar">
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="browser-dot"></span>
            <span class="editor-name">09_tariff_kpis.sql</span>
          </div>
          <pre class="editor-body"><code><span class="kw">SELECT</span> payment_system_id,
       <span class="fn">SUM</span>(amount) <span class="kw">AS</span> gmv,
       <span class="fn">SUM</span>(platform_fee_amount) <span class="kw">AS</span> revenue
<span class="kw">FROM</span> payments
<span class="kw">GROUP BY</span> payment_system_id
<span class="kw">ORDER BY</span> revenue <span class="kw">DESC</span>;</code></pre>
        </div>

        <div class="analytics-copy">
          <h2>Датасет и стек</h2>
          <p class="section-sub left">
            Синтетический, но правдоподобный датасет — с полноценной SQL и Python аналитикой поверх.
          </p>
          <div class="dataset-grid">
            {
              dataset.map((d) => (
                <div class="dataset-card">
                  <div class="dataset-value">{d.value}</div>
                  <div class="dataset-label">{d.label}</div>
                </div>
              ))
            }
          </div>
          <div class="stack-row">
            {stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <h2>Хочешь посмотреть SQL, датасет и разбор кейсов?</h2>
      <p>Полная бизнес-модель, KPI-запросы и аналитика — в репозитории на GitHub.</p>
      <a
        class="btn-primary"
        href="https://github.com/jaydenwhitehereboyz/saas-revenue-retention-analytics"
        target="_blank"
        rel="noopener">Открыть репозиторий →</a
      >
    </section>

    <footer class="footer">
      <div class="footer-inner">
        <a class="brand" href="#top">
          <svg class="mark small" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="40" height="40" rx="10" fill="#1F3FBF" />
            <path d="M9 11 L23 20 L9 29" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <circle cx="23" cy="20" r="2.6" fill="#E8A33D" />
            <path d="M23 20 L32 20" stroke="white" stroke-width="2.2" stroke-linecap="round" />
          </svg>
          <span class="wordmark small">Nexa<span class="wordmark-accent">Route</span></span>
        </a>
        <p>Учебный аналитический проект. Все компании, провайдеры и данные синтетические.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #eef1f5;
    --paper-raised: #ffffff;
    --ink: #12151b;
    --ink-soft: #5b6472;
    --brand: #1f3fbf;
    --brand-deep: #14297a;
    --amber: #e8a33d;
    --teal: #1c8c74;
    --line: #dce1e8;
    --line-strong: #c3cbd6;
    --radius: 14px;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Inter", -apple-system, "Segoe UI", sans-serif;
    scroll-behavior: smooth;
  }

  h1, h2, h3 {
    font-family: "Space Grotesk", sans-serif;
    letter-spacing: -0.01em;
    margin: 0;
  }

  a { color: inherit; text-decoration: none; }

  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(238, 241, 245, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: 1140px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .mark { width: 32px; height: 32px; }
  .mark.small { width: 26px; height: 26px; }
  .wordmark { font-family: "Space Grotesk", sans-serif; font-weight: 600; font-size: 17px; }
  .wordmark.small { font-size: 15px; color: var(--ink-soft); }
  .wordmark-accent { color: var(--brand); }

  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--ink-soft);
    flex: 1;
  }
  .nav-links a:hover { color: var(--ink); }

  .nav-right { display: flex; align-items: center; gap: 16px; }
  .status-pill {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--ink-soft);
    font-family: "IBM Plex Mono", monospace;
  }
  .status-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 0 rgba(28,140,116,0.5);
    animation: statusPing 2s infinite;
  }
  @keyframes statusPing {
    0% { box-shadow: 0 0 0 0 rgba(28,140,116,0.45); }
    70% { box-shadow: 0 0 0 6px rgba(28,140,116,0); }
